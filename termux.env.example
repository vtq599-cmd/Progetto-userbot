# Telegram API credentials: https://my.telegram.org
API_ID=
API_HASH=

# Required MTProxy settings
PROXY_SERVER=
PROXY_PORT=
PROXY_SECRET=
PROXY_PROTOCOL=auto

# Optional settings
LOGIN_METHOD=qr
BOT_PREFIX=7
# SESSION_NAME defaults to userbot/userbot.session
# Optional speech-to-text token for .vtt:
# WIT_TOKEN=
# Pollinations API key required for .ai and .sr:
# POLLINATIONS_API_KEY=
